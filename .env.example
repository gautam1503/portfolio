PORT=3000

# Token for reading messages: GET /api/messages with "Authorization: Bearer <ADMIN_TOKEN>"
ADMIN_TOKEN=change-me-to-a-long-random-string

# Email notifications for new contact messages (optional).
# For Gmail: enable 2-Step Verification, then create an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=gautampandey961@gmail.com
SMTP_PASS=
CONTACT_TO=gautampandey961@gmail.com

# Store messages in MongoDB instead of data/messages.json (optional, e.g. MongoDB Atlas free tier)
MONGODB_URI=
MONGODB_DB=portfolio
